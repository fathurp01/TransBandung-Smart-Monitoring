{
  "family": "tbsm-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::363626603740:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::363626603740:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "frontend-container",
      "image": "363626603740.dkr.ecr.us-east-1.amazonaws.com/tbsm-frontend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tbsm-frontend",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
